    Component {
      Type          CScript
      Name          "TPS_Gate_Generator"
      Show          on
      Position      [1090, 640]
      Direction     down
      Flipped       off
      LabelPosition west
      Parameter {
        Variable      "DialogGeometry"
        Value         "[723 261 641 678]"
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[3]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[1 1 1 1 1 1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "[0, -1; -2, 0]"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"\n"
"#define FSW     100000.0\n"
"#define TSW     (1.0 / FSW)\n"
"#define TWO_PI  6.2831853071795864769\n"
"\n"
"static double wrap_time(double x)\n"
"{\n"
"    while (x >= TSW) x -= TSW;\n"
"    while (x < 0.0)  x += TSW;\n"
"    return x;\n"
"}\n"
"\n"
"static int square_state(double t)\n"
"{\n"
"    double tau = wrap_time(t);\n"
"    return (tau < 0.5 * TSW) ? 1 : 0;\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double phi1 = InputSignal(0, 0);\n"
"double phi2 = InputSignal(0, 1);\n"
"double phi3 = InputSignal(0, 2);\n"
"\n"
"double d1 = (phi1 / TWO_PI) * TSW;\n"
"double d2 = (phi2 / TWO_PI) * TSW;\n"
"double d3 = (phi3 / TWO_PI) * TSW;\n"
"\n"
"int pL = square_state(CurrentTime);\n"
"int pR = square_state(CurrentTime - d1);\n"
"\n"
"int sL = square_state(CurrentTime + d3);\n"
"int sR = square_state(CurrentTime + d3 - d2);\n"
"\n"
"OutputSignal(0, 0) = pL;\n"
"OutputSignal(1, 0) = 1 - pL;\n"
"OutputSignal(2, 0) = pR;\n"
"OutputSignal(3, 0) = 1 - pR;\n"
"\n"
"OutputSignal(4, 0) = sL;\n"
"OutputSignal(5, 0) = 1 - sL;\n"
"OutputSignal(6, 0) = sR;\n"
"OutputSignal(7, 0) = 1 - sR;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
